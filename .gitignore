cat > .gitignore <<'EOF'
# Python environment and generated files
.venv/
__pycache__/
*.py[cod]

# Local settings
.env
.env.*
!.env.example

# Downloaded model weights
models/
*.gguf
*.safetensors

# Re-downloadable source data
data/raw/

# Generated results; commit only the frozen v0.1 release
/results/*
!/results/v0.1/
EOF